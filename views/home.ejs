<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Human Unity Union - Home</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-danger">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/home">
        <i class="fas fa-hands-helping me-2"></i>Human Unity Union
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav me-auto">
          <li class="nav-item"><a class="nav-link active" href="/home">Home</a></li>
          <li class="nav-item"><a class="nav-link" href="/donor/register">Donor Registration</a></li>
          <li class="nav-item"><a class="nav-link" href="/donors">Donor List</a></li>
          <li class="nav-item"><a class="nav-link" href="/drives">Drives</a></li>
        </ul>
        <ul class="navbar-nav">
          <% if (user) { %>
            <% if (user.role === 'admin' || user.role === 'staff') { %>
              <li class="nav-item"><a class="nav-link" href="/admin/dashboard">Dashboard</a></li>
            <% } %>
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                <i class="fas fa-user me-1"></i><%= user.name %>
              </a>
              <ul class="dropdown-menu">
                <li>
                  <form action="/api/auth/logout" method="POST" style="display: inline;">
                    <button class="dropdown-item" type="submit">Logout</button>
                  </form>
                </li>
              </ul>
            </li>
          <% } else { %>
            <li class="nav-item"><a class="nav-link" href="/login">Login</a></li>
            <li class="nav-item"><a class="nav-link" href="/signup">Sign Up</a></li>
          <% } %>
        </ul>
      </div>
    </div>
  </nav>

  <header class="bg-primary text-white py-5">
    <div class="container text-center">
      <h1 class="display-4 fw-bold">Human Unity Union</h1>
      <p class="lead">Serving Humanity with Unity and Compassion</p>
      <div class="mt-4">
        <a href="/donor/register" class="btn btn-light btn-lg me-2">Register as Blood Donor</a>
        <% if (!user) { %>
          <a href="/signup" class="btn btn-outline-light btn-lg">Join Us</a>
        <% } %>
      </div>
    </div>
  </header>

  <section class="py-5">
    <div class="container">
      <div class="row g-4">
        <div class="col-md-3">
          <div class="card h-100 border-0 shadow-sm">
            <div class="card-body text-center">
              <i class="fas fa-tint text-danger fa-3x mb-3"></i>
              <h5 class="card-title">Blood Donation</h5>
              <p class="card-text">Save lives through blood donation camps and regular donation drives.</p>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card h-100 border-0 shadow-sm">
            <div class="card-body text-center">
              <i class="fas fa-tree text-success fa-3x mb-3"></i>
              <h5 class="card-title">Plantation Drives</h5>
              <p class="card-text">Making the world greener through community plantation initiatives.</p>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card h-100 border-0 shadow-sm">
            <div class="card-body text-center">
              <i class="fas fa-utensils text-warning fa-3x mb-3"></i>
              <h5 class="card-title">Rashan Drives</h5>
              <p class="card-text">Food and ration distribution for underprivileged communities.</p>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card h-100 border-0 shadow-sm">
            <div class="card-body text-center">
              <i class="fas fa-briefcase text-info fa-3x mb-3"></i>
              <h5 class="card-title">Rozgar Drives</h5>
              <p class="card-text">Employment opportunities and skill development programs.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-5 bg-light">
    <div class="container">
      <div class="text-center mb-5">
        <h2 class="fw-bold">Our Impact</h2>
        <p class="text-muted">Making a difference together</p>
      </div>
      <div class="row g-4">
        <div class="col-md-4">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center">
              <h3 class="text-danger fw-bold"><%= typeof stats !== 'undefined' && stats && stats.totalDonors ? stats.totalDonors : '0' %></h3>
              <p class="text-muted">Blood Donors Registered</p>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center">
              <h3 class="text-primary fw-bold"><%= typeof stats !== 'undefined' && stats && stats.totalDrives ? stats.totalDrives : '0' %></h3>
              <p class="text-muted">Total Drives Conducted</p>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center">
              <h3 class="text-success fw-bold"><%= typeof stats !== 'undefined' && stats && stats.activeDrives ? stats.activeDrives : '0' %></h3>
              <p class="text-muted">Active Drives</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-5">
    <div class="container">
      <div class="text-center mb-5">
        <h2 class="fw-bold">Active Drives</h2>
        <p class="text-muted">Join us in making a difference</p>
      </div>
      <div class="row g-4">
        <% if (typeof drives !== 'undefined' && drives && drives.length > 0) { %>
          <% drives.forEach(drive => { %>
            <div class="col-md-4">
              <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                  <div class="d-flex justify-content-between align-items-start mb-2">
                    <h5 class="card-title"><%= drive.name %></h5>
                    <span class="badge bg-success">Active</span>
                  </div>
                  <p class="card-text text-muted"><%= drive.description ? drive.description.substring(0, 100) + '...' : '' %></p>
                  <div class="mb-2">
                    <small class="text-muted"><i class="fas fa-map-marker-alt me-1"></i><%= drive.location ? drive.location.venue + ', ' + drive.location.city : '' %></small>
                  </div>
                  <div>
                    <small class="text-muted"><i class="fas fa-calendar me-1"></i><%= drive.date ? new Date(drive.date.startDate).toLocaleDateString() : '' %></small>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="col-12 text-center text-muted">
            <p>No active drives at the moment. Check back soon!</p>
          </div>
        <% } %>
      </div>
    </div>
  </section>

  <footer class="bg-dark text-white py-4">
    <div class="container">
      <div class="row">
        <div class="col-md-6">
          <h5>Human Unity Union</h5>
          <p class="mb-0">Serving Humanity with Unity and Compassion</p>
        </div>
        <div class="col-md-6 text-md-end">
          <p class="mb-0">&copy; 2026 Human Unity Union. All rights reserved.</p>
        </div>
      </div>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
